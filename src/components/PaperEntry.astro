---
import { render, type CollectionEntry } from 'astro:content';
import { inlineEmphasis, listSeparator, paperLinks } from '../lib/format';

interface Props {
  paper: CollectionEntry<'papers'>;
  variant: 'compact' | 'full' | 'feature';
}

const { paper, variant } = Astro.props;
const { title, coauthors, status, note, links } = paper.data;

const hasAbstract = Boolean(paper.body?.trim());
const Abstract = hasAbstract ? (await render(paper)).Content : undefined;
const linkItems = paperLinks(links);
---

<article class={`paper paper--${variant}`}>
  <h3 class="paper-title">{title}</h3>
  {
    coauthors.length > 0 && (
      <p class="paper-meta">
        with{' '}
        {coauthors.map((c, i) => (
          <>
            {c.url ? <a class="coauthor" href={c.url}>{c.name}</a> : c.name}
            {listSeparator(i, coauthors.length)}
          </>
        ))}
      </p>
    )
  }
  {status && <p class="paper-status" set:html={inlineEmphasis(status)} />}
  {note && <p class="paper-note">{note}</p>}
  {
    (Abstract || linkItems.length > 0) && (
      <div class:list={['paper-actions', { 'paper-actions--abstract': Abstract }]}>
        {Abstract && (
          <details>
            <summary>
              Abstract<span class="visually-hidden"> of “{title}”</span>
            </summary>
            <div class="paper-abstract">
              <Abstract />
            </div>
          </details>
        )}
        {linkItems.length > 0 && (
          <span class="paper-links">
            {linkItems.map((item) => (
              <a href={item.href}>
                {item.label}
                <span class="visually-hidden"> for “{title}”</span>
              </a>
            ))}
          </span>
        )}
      </div>
    )
  }
</article>
