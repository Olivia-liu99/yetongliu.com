---
interface Props {
  current?: 'home' | 'research' | 'teaching';
  name: string;
  nameChinese?: string;
  hasCv: boolean;
  showTeaching: boolean;
}

const { current, name, nameChinese, hasCv, showTeaching } = Astro.props;

const items = [
  { label: 'Research', href: '/research/', key: 'research' },
  ...(showTeaching ? [{ label: 'Teaching', href: '/teaching/', key: 'teaching' }] : []),
  ...(hasCv ? [{ label: 'CV', href: '/cv.pdf', key: 'cv' }] : []),
];
---

<header class="site-header page">
  <div class="site-header-inner">
    {
      current === 'home' ? (
        <h1 class="site-name" translate="no">
          {name}
          {nameChinese && <span class="name-chinese" lang="zh">{nameChinese}</span>}
        </h1>
      ) : (
        <a class="site-name" href="/" translate="no">
          {name}
          {nameChinese && <span class="name-chinese" lang="zh">{nameChinese}</span>}
        </a>
      )
    }
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
