---
interface Props {
  current?: 'home' | 'research' | 'teaching';
  name: string;
  nameChinese?: string;
  hasCv: boolean;
  showTeaching: boolean;
}

const { current, name, nameChinese, hasCv, showTeaching } = Astro.props;

// The CV opens in a new tab, so visitors keep the site open behind it.
const items: { label: string; href: string; key: string; newTab?: boolean }[] = [
  { label: 'Research', href: '/research/', key: 'research' },
  ...(showTeaching ? [{ label: 'Teaching', href: '/teaching/', key: 'teaching' }] : []),
  ...(hasCv ? [{ label: 'CV', href: '/cv.pdf', key: 'cv', newTab: true }] : []),
];
---

<header class="site-header page">
  <div class="site-header-inner">
    {
      current === 'home' ? (
        <h1 class="site-name" translate="no">
          {name}
          {nameChinese && <span class="name-chinese" lang="zh">{nameChinese}</span>}
        </h1>
      ) : (
        <a class="site-name" href="/" translate="no">
          {name}
          {nameChinese && <span class="name-chinese" lang="zh">{nameChinese}</span>}
        </a>
      )
    }
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.key === current ? 'page' : undefined}
                target={item.newTab ? '_blank' : undefined}
              >
                {item.label}
                {item.newTab && <span class="visually-hidden"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
